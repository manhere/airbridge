// AirSense 10 UART simulator - dialog resources (UTF-8)
#include "resource.h"

#define APSTUDIO_READONLY_SYMBOLS
#include "afxres.h"
#undef APSTUDIO_READONLY_SYMBOLS

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_CHS)
LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
#pragma code_page(65001)

IDD_MAIN_DIALOG DIALOGEX 0, 0, 900, 452
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "AirSense 10 串口模拟设备 - 通讯日志与指令解读"
FONT 9, "Microsoft YaHei UI", 0, 0, 0x1
BEGIN
    LTEXT           "串口:",IDC_STATIC,8,11,30,12
    COMBOBOX        IDC_COMBO_PORT,40,8,120,140,CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "刷新",IDC_BUTTON_REFRESH_PORTS,164,7,44,20
    LTEXT           "波特率:",IDC_STATIC_BAUD_LABEL,216,11,36,12
    COMBOBOX        IDC_COMBO_BAUD,252,8,80,120,CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "打开串口",IDC_BUTTON_OPEN,340,7,72,22
    LTEXT           "状态：未连接",IDC_STATIC_STATUS,420,11,176,12
    CONTROL         "显示 HEX",IDC_CHECK_HEX,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,600,10,66,14
    CONTROL         "暂停滚动",IDC_CHECK_PAUSE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,668,10,66,14
    PUSHBUTTON      "自检演示",IDC_BUTTON_DEMO,742,7,72,22
    PUSHBUTTON      "保存日志",IDC_BUTTON_SAVE,820,7,72,22

    GROUPBOX        "设备状态与故障注入",IDC_STATIC,8,32,884,46
    LTEXT           "ROP:",IDC_STATIC,16,52,24,12
    COMBOBOX        IDC_COMBO_ROP,42,48,96,90,CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    CONTROL         "CSG 返回 6009",IDC_CHECK_FAULT_CSG,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,146,51,96,12
    CONTROL         "ROP 不响应",IDC_CHECK_FAULT_TIMEOUT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,250,51,84,12
    CONTROL         "应答坏 CRC",IDC_CHECK_FAULT_CRC,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,342,51,84,12
    CONTROL         "推送实时流",IDC_CHECK_LIVE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,434,51,84,12
    LTEXT           "计数：RX 0 / TX 0 / 错误 0",IDC_STATIC_COUNTS,528,52,240,12
    PUSHBUTTON      "清空日志",IDC_BUTTON_CLEAR,806,46,80,20

    GROUPBOX        "串口通讯日志（点击任一行查看逐字段解读）",IDC_STATIC,8,84,578,292
    CONTROL         "",IDC_LIST_LOG,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,14,96,566,268
    GROUPBOX        "帧结构与指令解读",IDC_STATIC,594,84,298,292
    EDITTEXT        IDC_EDIT_DETAIL,600,96,286,268,ES_MULTILINE | ES_READONLY | WS_VSCROLL | ES_AUTOHSCROLL

    LTEXT           "手动注入设备→主机帧（类型 内容）：",IDC_STATIC,8,382,200,12
    EDITTEXT        IDC_EDIT_CMD,8,396,420,22,ES_AUTOHSCROLL
    PUSHBUTTON      "注入帧",IDC_BUTTON_SEND,434,395,64,22
    LTEXT           "接线：USB-UART TX→GPIO44，RX←GPIO43，57600 8N1，共地；无硬件可点“自检演示”",IDC_STATIC,506,399,386,12
    LTEXT           "示例：R G S #ROP = 0001   /   E G S #XXX = 6006   /   L TCE00001002",IDC_STATIC,8,424,620,12
END

#ifdef APSTUDIO_INVOKED
1 TEXTINCLUDE
BEGIN
    "resource.h\0"
END
2 TEXTINCLUDE
BEGIN
    "\0"
END
3 TEXTINCLUDE
BEGIN
    "\r\n"
    "\0"
END
#endif

IDD_MAIN_DIALOG AFX_DIALOG_LAYOUT
BEGIN
    0
END

#ifdef APSTUDIO_INVOKED
GUIDELINES DESIGNINFO
BEGIN
    IDD_MAIN_DIALOG, DIALOG
    BEGIN
    END
END
#endif

#endif
